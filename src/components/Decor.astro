---
// Motifs décoratifs des temps forts, au trait doré. Noël utilise les dessins
// de la charte (public/brand/noel, extraits du fichier Illustrator) ; les
// autres décors sont provisoires en attendant leurs dessins.
// À placer dans un parent en position: relative ; purement décoratif.
import type { TempsFort } from '../lib/data';

interface Props {
  type: TempsFort['decor'];
  /** Coins ornés (cadre façon menu de Noël). */
  coins?: boolean;
  class?: string;
}
const { type, coins = type === 'flocons', class: classe } = Astro.props;

// Positions et tailles des motifs (en % du parent, taille en px).
const places = [
  { x: 9, y: 16, t: 26, r: -12, f: 1 },
  { x: 15, y: 30, t: 16, r: 10, f: 3 },
  { x: 86, y: 14, t: 22, r: 14, f: 2 },
  { x: 92, y: 26, t: 15, r: -6, f: 3 },
  { x: 90, y: 74, t: 28, r: -6, f: 1 },
  { x: 8, y: 80, t: 18, r: 20, f: 2 },
  { x: 50, y: 6, t: 14, r: 0, f: 3 },
];
---

{
  type !== 'aucun' && (
    <div class:list={['decor', classe]} aria-hidden="true">
      {coins &&
        ['hg', 'hd', 'bd', 'bg'].map((c) => <img class:list={['coin', `coin--${c}`]} src="/brand/noel/coin.svg" alt="" width="64" height="64" />)}
      {places.map((p, i) =>
        type === 'flocons' ? (
          <img class="tf-motif" src={`/brand/noel/flocon-${p.f}.svg`} alt="" style={`left:${p.x}%;top:${p.y}%;width:${p.t}px;--r:${p.r}deg;--i:${i}`} />
        ) : (
          <svg class="tf-motif" viewBox="-50 -50 100 100" style={`left:${p.x}%;top:${p.y}%;width:${p.t * 1.6}px;--r:${p.r}deg;--i:${i}`}>
            {type === 'citrouilles' && (
              <g>
                <ellipse cx="0" cy="8" rx="40" ry="32" />
                <ellipse cx="0" cy="8" rx="22" ry="32" />
                <path d="M0 -24 C 0 -24 -2 -34 6 -42" />
                <path d="M6 -36 C 16 -42 22 -36 26 -30" />
              </g>
            )}
            {type === 'couronne' && (
              <g>
                <path d="M-40 26 L-40 -14 L-20 6 L0 -30 L20 6 L40 -14 L40 26 Z" />
                <line x1="-40" y1="14" x2="40" y2="14" />
                <circle cx="-40" cy="-18" r="4" />
                <circle cx="0" cy="-34" r="4" />
                <circle cx="40" cy="-18" r="4" />
              </g>
            )}
            {type === 'etoiles' && <path d="M0 -44 C 4 -8 8 -4 44 0 C 8 4 4 8 0 44 C -4 8 -8 4 -44 0 C -8 -4 -4 -8 0 -44 Z" />}
          </svg>
        ),
      )}
    </div>
  )
}

<style>
  .decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .coin {
    position: absolute;
    width: clamp(40px, 6vw, 64px);
    height: auto;
  }
  .coin--hg {
    top: 14px;
    left: 14px;
  }
  .coin--hd {
    top: 14px;
    right: 14px;
    transform: scaleX(-1);
  }
  .coin--bd {
    bottom: 14px;
    right: 14px;
    transform: scale(-1, -1);
  }
  .coin--bg {
    bottom: 14px;
    left: 14px;
    transform: scaleY(-1);
  }
  .tf-motif {
    position: absolute;
    height: auto;
    opacity: 0.8;
    transform: translate(-50%, 0) rotate(var(--r));
    animation: flotte 9s var(--ease-doux) calc(var(--i) * -1.7s) infinite alternate;
  }
  svg.tf-motif {
    fill: none;
    stroke: var(--or);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.55;
  }
  @keyframes flotte {
    to {
      transform: translate(-50%, 8px) rotate(calc(var(--r) + 14deg));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tf-motif {
      animation-duration: 18s;
    }
  }
  @media (max-width: 640px) {
    .tf-motif:nth-of-type(n + 5) {
      display: none;
    }
  }
</style>
