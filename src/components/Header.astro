---
import { pagesVisibles } from '../lib/data';

const pages = pagesVisibles();
const liens = [
  { href: '/', label: 'Accueil' },
  pages.laBoucherie && { href: '/la-boucherie', label: 'La boucherie' },
  { href: '/commander', label: 'Click & collect', fort: true },
  pages.nosProduits && { href: '/nos-produits', label: 'Nos produits' },
  { href: '/infos-pratiques', label: 'Infos pratiques' },
].filter((l): l is { href: string; label: string; fort?: boolean } => !!l);
const chemin = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="entete">
  <div class="conteneur entete-barre">
    <a href="/" class="logo" aria-label="Boucherie Villenière — accueil">
      <img src="/brand/logo.svg" alt="" width="200" height="46" />
    </a>

    <button class="burger" aria-expanded="false" aria-controls="menu-principal">
      <span class="visuellement-cache">Menu</span>
      <span aria-hidden="true"></span>
    </button>

    <nav id="menu-principal" class="menu" aria-label="Navigation principale">
      <ul>
        {
          liens.map((l) => (
            <li>
              <a class:list={[l.fort ? 'bouton bouton--or' : 'lien']} href={l.href} aria-current={chemin === l.href ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const entete = document.querySelector('.entete');
  burger?.addEventListener('click', () => {
    const ouvert = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!ouvert));
    entete?.classList.toggle('ouvert', !ouvert);
  });
  // L'en-tête se resserre dès qu'on quitte le haut de page.
  const defiler = () => entete?.classList.toggle('defile', window.scrollY > 24);
  window.addEventListener('scroll', defiler, { passive: true });
  defiler();
</script>

<style>
  .entete {
    position: relative;
    background: rgb(250 247 241 / 0);
    border-bottom: 1px solid transparent;
    transition:
      background 0.4s,
      border-color 0.4s,
      box-shadow 0.4s;
  }
  .entete.defile,
  .entete.ouvert {
    background: rgb(250 247 241 / 0.92);
    backdrop-filter: blur(10px);
    border-color: var(--ligne);
    box-shadow: 0 10px 30px -24px rgb(21 24 27 / 0.5);
  }
  .entete-barre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 80px;
    transition: min-height 0.4s var(--ease);
  }
  .defile .entete-barre {
    min-height: 64px;
  }
  .logo img {
    width: clamp(150px, 17vw, 210px);
    height: auto;
    transition: width 0.4s var(--ease);
  }
  .defile .logo img {
    width: clamp(140px, 14vw, 170px);
  }
  .menu {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .menu ul {
    display: flex;
    align-items: center;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu ul .lien {
    font: 500 0.82rem/1 var(--corps);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  .menu ul .lien:hover,
  .menu ul .lien[aria-current='page'] {
    text-decoration-color: var(--or);
  }
  .burger {
    display: none;
  }

  .menu .bouton {
    min-height: 44px;
    padding: 12px 22px;
    white-space: nowrap;
  }

  @media (max-width: 1080px) {
    .burger {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 0;
      background: none;
      cursor: pointer;
    }
    .burger span[aria-hidden],
    .burger span[aria-hidden]::before,
    .burger span[aria-hidden]::after {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--anthracite);
      transition: transform 0.2s;
      content: '';
    }
    .burger span[aria-hidden]::before {
      transform: translateY(-7px);
    }
    .burger span[aria-hidden]::after {
      transform: translateY(5px);
    }
    .ouvert .burger span[aria-hidden] {
      background: transparent;
    }
    .ouvert .burger span[aria-hidden]::before {
      transform: translateY(0) rotate(45deg);
    }
    .ouvert .burger span[aria-hidden]::after {
      transform: translateY(-2px) rotate(-45deg);
    }
    .menu {
      display: none;
      position: absolute;
      inset: 100% 0 auto;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gouttiere) 24px;
      background: var(--papier);
      border-bottom: 1px solid var(--ligne);
    }
    .ouvert .menu {
      display: flex;
    }
    .menu ul {
      flex-direction: column;
      gap: 0;
    }
    .menu ul {
      align-items: stretch;
    }
    .menu ul .lien {
      display: block;
      padding: 16px 0;
      border-bottom: 1px solid var(--ligne);
    }
    .menu .bouton {
      display: flex;
      margin: 14px 0;
    }
  }
</style>
