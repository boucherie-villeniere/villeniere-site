---
import { getReglages } from '../lib/data';
import { JOURS_LABELS, ORDRE_JOURS } from '../lib/commande';

const horaires = [...getReglages().horaires].sort((a, b) => ORDRE_JOURS.indexOf(a.jour) - ORDRE_JOURS.indexOf(b.jour));
---

<dl class="horaires">
  {
    horaires.map((h) => (
      <div data-jour={h.jour}>
        <dt>{JOURS_LABELS[h.jour]}</dt>
        <dd>{h.plages}</dd>
      </div>
    ))
  }
</dl>

<script>
  import { chargerHoraires, jourParis } from '../lib/horaires-client';
  // Met en avant le jour courant (heure de Paris).
  document.querySelectorAll(`.horaires [data-jour="${jourParis()}"]`).forEach((el) => el.classList.add('aujourdhui'));
  // Si la fiche Google est reliée, ses horaires (fermetures exceptionnelles comprises) remplacent ceux de l'admin.
  chargerHoraires().then((g) => {
    if (!g) return;
    document.querySelectorAll<HTMLElement>('.horaires [data-jour]').forEach((el) => {
      const jour = el.dataset.jour as keyof typeof g.jours;
      const texte = g.jours[jour];
      if (!texte) return;
      el.querySelector('dd')!.textContent = texte;
      el.classList.toggle('exceptionnel', g.exceptions.includes(jour));
    });
  });
</script>

<style>
  .horaires {
    margin: 0;
    display: grid;
    gap: 4px;
  }
  .horaires div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 3px;
    border-bottom: 1px dotted rgb(194 160 99 / 0.4);
  }
  dt {
    font-weight: 500;
  }
  dd {
    margin: 0;
    text-align: right;
  }
  .aujourdhui {
    color: var(--or);
  }
  .exceptionnel dd::after {
    content: ' *';
    color: var(--or);
  }
</style>
