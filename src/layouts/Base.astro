---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TempsFortsPopup from '../components/TempsFortsPopup.astro';
import { getReglages } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** false : pas de pied de page (page déjà consacrée aux infos pratiques). */
  piedDePage?: boolean;
}

const { piedDePage = true, title, description = 'Boucherie Villenière à Romainville : viandes d’éleveurs choisis, préparations maison, poulets rôtis et click & collect.', image = '/images/accueil/facade.webp' } = Astro.props;
const r = getReglages();
const titreComplet = title === 'Accueil' ? 'Boucherie Villenière — Romainville' : `${title} — Boucherie Villenière`;
const canonique = new URL(Astro.url.pathname, Astro.site);

// Bandeau d'annonce : le message est répété pour remplir les grands écrans,
// et la piste est dupliquée pour une boucle sans à-coup. Durée proportionnelle
// à la longueur pour garder la même vitesse quel que soit le message.
const annonce = r.annonce?.trim();
const repetitions = annonce ? Math.max(2, Math.ceil(240 / (annonce.length + 6))) : 0;
const dureeAnnonce = annonce ? Math.round((annonce.length + 6) * repetitions * 0.22) : 0;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ButcherShop',
  name: 'Boucherie Villenière',
  url: Astro.site?.href,
  image: new URL(image, Astro.site).href,
  telephone: r.telephone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: r.adresse,
    postalCode: r.codePostal,
    addressLocality: r.ville,
    addressCountry: 'FR',
  },
  sameAs: [r.instagram, r.facebook].filter(Boolean),
  // Les horaires sont saisis en texte libre : Google les lit sur la fiche
  // Google Business, inutile de risquer un format invalide ici.
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#15181b" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <!-- Active les animations avant le premier affichage, pour éviter un flash du contenu. -->
    <script is:inline>
      if ('IntersectionObserver' in window) document.documentElement.classList.add('anim');
    </script>
  </head>
  <body>
    <a class="visuellement-cache" href="#contenu">Aller au contenu</a>
    <div class="haut-de-page">
    {
      annonce && (
        <div class="annonce" style={`--duree:${dureeAnnonce}s`}>
          <p class="visuellement-cache">{annonce}</p>
          <div class="annonce-piste" aria-hidden="true">
            {[0, 1].map(() => (
              <span class="annonce-moitie">
                {Array.from({ length: repetitions }, () => (
                  <span class="annonce-item">
                    {annonce}
                    <span class="annonce-sep">✦</span>
                  </span>
                ))}
              </span>
            ))}
          </div>
        </div>
      )
    }
    <Header />
    </div>
    <main id="contenu">
      <slot />
    </main>
    {piedDePage && <Footer />}
    <TempsFortsPopup />
  </body>
</html>

<script>
  // Révèle en fondu les éléments [data-reveal] quand ils entrent dans l'écran.
  if (document.documentElement.classList.contains('anim')) {
    const observateur = new IntersectionObserver(
      (entrees) => {
        for (const e of entrees) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('visible');
          observateur.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
    );
    document.querySelectorAll('[data-reveal]').forEach((el) => observateur.observe(el));
  }
</script>

<style>
  /* Bandeau et en-tête restent ancrés en haut pendant le défilement. */
  .haut-de-page {
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .annonce {
    background: var(--or);
    color: var(--anthracite);
    font: 500 0.9rem/1.4 var(--corps);
    padding: 7px 0;
    overflow: hidden;
    white-space: nowrap;
  }
  .annonce-piste {
    display: flex;
    width: max-content;
    animation: annonce var(--duree, 40s) linear infinite;
  }
  .annonce:hover .annonce-piste {
    animation-play-state: paused;
  }
  .annonce-moitie {
    display: flex;
  }
  .annonce-item {
    display: inline-flex;
    align-items: center;
  }
  .annonce-sep {
    font-size: 0.6em;
    margin: 0 2.2em;
    opacity: 0.55;
  }
  @keyframes annonce {
    to {
      transform: translateX(-50%);
    }
  }
  /* Mouvement réduit : on garde le défilement (le message doit rester lisible
     en entier) mais deux fois plus lent, comme la frise. */
  @media (prefers-reduced-motion: reduce) {
    .annonce-piste {
      animation-duration: calc(var(--duree, 40s) * 2);
    }
  }
</style>
