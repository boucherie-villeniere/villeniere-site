---
// Page d'un temps fort (ex. /noel). Toujours accessible tant que le temps fort
// est activé dans l'admin, même hors de ses dates (lien à partager à l'avance).
import Base from '../layouts/Base.astro';
import Decor from '../components/Decor.astro';
import Photo from '../components/Photo.astro';
import CarteMenu from '../components/CarteMenu.astro';
import CommandeCarte from '../components/CommandeCarte.tsx';
import { getClickCollect, getReglages, getTempsForts, lienTempsFort, paragraphes, type TempsFort } from '../lib/data';
import { formaterDate } from '../lib/commande';
import { farcesAvecPrix, produitsCommandables, reglesEvenement } from '../lib/evenement';
import '../styles/commander.css';

export function getStaticPaths() {
  return getTempsForts().map((t) => ({ params: { tempsFort: t.slug }, props: { t } }));
}

const { t } = Astro.props as { t: TempsFort };
const r = getReglages();
const lien = lienTempsFort(t);
const versPage = lien === `/${t.slug}`;
const aUneCarte = (t.carte?.rubriques ?? []).length > 0;
const cc = getClickCollect();
const commande = aUneCarte && t.carte?.commande?.actif;
const limite = t.carte?.commande?.dateLimite;
---

<Base title={t.nom} description={t.accroche ?? t.titre} image={t.image ?? undefined}>
  <header class="tf-entete">
    <Decor type={t.decor} coins={false} />
    <div class="conteneur">
      {t.surtitre && <p class="surtitre" data-reveal>{t.surtitre}</p>}
      <h1 data-reveal style="--i:1">{t.titre}</h1>
      {t.accroche && <p class="chapo" data-reveal style="--i:2">{t.accroche}</p>}
      <img class="frise" src="/brand/frise-or.svg" alt="" width="560" height="44" data-reveal style="--i:3" />
    </div>
  </header>

  <section class="section tf-contenu">
    <div class:list={['conteneur', 'tf-grille', { 'avec-image': !!t.image }]}>
      {t.image && <Photo src={t.image} alt={t.titre} ratio="4 / 5" eager class="cadre-decale" />}
      <div class="tf-texte">
        {paragraphes(t.texte).map((p, i) => <p data-reveal style={`--i:${i}`}>{p}</p>)}
        <div class="tf-actions" data-reveal>
          {!versPage && (
            <a class="bouton" href={lien}>
              {t.bouton?.texte || 'Commander'} <span class="fleche" aria-hidden="true">→</span>
            </a>
          )}
          {r.telephone && (
            <a class:list={['bouton', { 'bouton--contour': !versPage }]} href={`tel:${r.telephone.replace(/\s/g, '')}`}>
              Appeler la boutique · {r.telephone}
            </a>
          )}
        </div>
        {(r.sms || r.adresse) && (
          <p class="tf-contacts" data-reveal>
            {r.sms && <>Par SMS : <a href={`sms:${r.sms.replace(/\s/g, '')}`}>{r.sms}</a><br /></>}
            En boutique : {r.adresse}, {r.codePostal} {r.ville}
          </p>
        )}
      </div>
    </div>
  </section>

  {
    aUneCarte && (
      <section class="section tf-carte" id="carte" aria-label="La carte">
        <div class="conteneur tf-carte-cadre">
          <Decor type={t.decor} motifs={false} />
          <div class="tf-carte-corps">
            {commande && (
              <>
                <p class="tf-commande-aide" data-commande-aide hidden>
                  <span class="tf-plus" aria-hidden="true">+</span>
                  <span>
                    {t.carte!.commande!.message}
                    {limite && <strong class="tf-limite">Commandes en ligne jusqu’au {formaterDate(limite)}.</strong>}
                  </span>
                </p>
                <p class="tf-commande-aide" data-commande-fermee hidden>
                  <span>
                    Les commandes en ligne sont closes.
                    {r.telephone && <> Pour une demande de dernière minute, appelez-nous au <a href={`tel:${r.telephone.replace(/\s/g, '')}`}>{r.telephone}</a>.</>}
                  </span>
                </p>
              </>
            )}
            <CarteMenu carte={t.carte!} />
          </div>
        </div>
      </section>
    )
  }
  {
    commande && (
      <CommandeCarte
        client:load
        evenement={t.slug}
        nom={t.nom}
        produits={produitsCommandables(t)}
        farces={farcesAvecPrix(t.carte)}
        adresse={`${r.adresse}, ${r.codePostal} ${r.ville}`}
        regles={reglesEvenement(t, cc)}
        mentionPaiement={cc.mentionPaiement}
      />
    )
  }
</Base>

<style>
  .tf-entete {
    position: relative;
    padding-block: clamp(56px, 9vw, 112px) clamp(24px, 4vw, 48px);
    text-align: center;
  }
  .tf-entete .conteneur {
    position: relative;
  }
  .chapo {
    margin-inline: auto;
    color: var(--gris);
    max-width: 52ch;
  }
  .frise {
    margin: 32px auto 0;
  }
  .tf-grille {
    max-width: 760px;
  }
  .tf-grille.avec-image {
    max-width: var(--largeur);
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .tf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 2em;
  }
  .tf-actions .bouton {
    white-space: normal;
    line-height: 1.4;
    text-align: center;
  }
  .tf-limite {
    display: block;
    margin-top: 0.3em;
    color: var(--anthracite);
    font-weight: 500;
  }
  .tf-contacts {
    margin-top: 1.6em;
    color: var(--gris);
    font-size: 0.95rem;
  }
  .tf-carte-cadre {
    position: relative;
    max-width: 880px;
    background: var(--blanc);
    border: 1px solid var(--or);
    outline: 1px solid var(--or);
    outline-offset: 6px;
    padding: clamp(40px, 7vw, 80px) clamp(18px, 6vw, 72px);
  }
  .tf-carte-corps {
    position: relative;
  }
  .tf-commande-aide {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    max-width: 36em;
    margin: 0 auto 2.6em;
    padding: 14px 20px;
    background: var(--papier);
    color: var(--gris);
    font-size: 0.95rem;
    text-align: left;
  }
  .tf-plus {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--or);
    border-radius: 999px;
    color: var(--or-fonce);
    font-size: 1.2rem;
  }
  /* Barre « Ma commande » et fenêtre de commande (CommandeCarte.tsx) */
  :global(.cdc-barre) {
    position: fixed;
    left: 50%;
    bottom: 16px;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 20px;
    width: min(620px, calc(100vw - 24px));
    padding: 10px 10px 10px 22px;
    background: var(--anthracite);
    color: var(--papier);
    border-radius: 999px;
    box-shadow: 0 16px 40px rgba(21, 24, 27, 0.3);
    transform: translate(-50%, 140%);
    transition: transform 0.6s var(--ease-doux);
  }
  :global(.cdc-barre.visible) {
    transform: translate(-50%, 0);
  }
  :global(.cdc-barre-texte) {
    flex: 1;
    display: grid;
    line-height: 1.3;
    animation: tf-pulse 0.5s var(--ease-doux);
  }
  :global(.cdc-barre-texte strong) {
    font: italic 500 1.1rem/1.2 var(--titre);
    color: var(--or);
  }
  :global(.cdc-barre-texte span) {
    font-size: 0.88rem;
    color: #d9d4cb;
  }
  @keyframes tf-pulse {
    from {
      transform: scale(1.04);
    }
  }
  :global(.cdc-choix-groupe) {
    border: 0;
    padding: 0;
    margin: 0 0 22px;
  }
  :global(.cdc-choix-groupe legend) {
    padding: 0;
    margin-bottom: 8px;
    font-weight: 500;
    color: var(--anthracite);
  }
  :global(.cdc-options) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  :global(.cdc-options--colonne) {
    flex-direction: column;
  }
  :global(.cdc-poids) {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  :global(.cdc-poids input) {
    width: 6em;
    min-height: 44px;
    padding: 8px 12px;
    font: inherit;
    text-align: center;
    border: 1px solid var(--ligne);
    border-radius: var(--rayon);
    background: var(--blanc);
  }
  :global(.cdc-sauce) {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    min-height: 32px;
    font-size: 0.88rem;
    color: var(--anthracite);
    cursor: pointer;
  }
  :global(.cdc-sauce input) {
    width: 18px;
    height: 18px;
    accent-color: var(--anthracite);
  }
  :global(.cdc-estimation) {
    margin: 0 0 18px;
    color: var(--gris);
  }
  :global(.cdc-estimation strong) {
    color: var(--anthracite);
  }
  :global(.cdc-merci ul) {
    list-style: none;
    margin: 18px auto;
    padding: 0;
    max-width: 30em;
    text-align: left;
  }
  :global(.cdc-merci li) {
    padding: 6px 0;
    border-bottom: 1px solid var(--ligne);
  }
  :global(.cdc-fenetre) {
    width: min(640px, calc(100vw - 24px));
    max-height: calc(100dvh - 24px);
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: var(--papier);
    box-shadow: 0 30px 80px rgba(21, 24, 27, 0.35);
  }
  :global(.cdc-fenetre::backdrop) {
    background: rgba(21, 24, 27, 0.55);
  }
  :global(.cdc-fenetre[open]) {
    animation: tf-monte 0.5s var(--ease-doux);
  }
  @keyframes tf-monte {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  :global(.cdc-contenu) {
    position: relative;
    padding: clamp(28px, 5vw, 44px) clamp(18px, 5vw, 40px);
  }
  :global(.cdc-contenu h2) {
    margin: 0.1em 0 0.8em;
  }
  :global(.cdc-fermer) {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 999px;
    background: var(--blanc);
    cursor: pointer;
  }
  :global(.cdc-fermer path) {
    stroke: var(--anthracite);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  :global(.cdc-lignes) {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
  }
  :global(.cdc-lignes li) {
    display: grid;
    grid-template-columns: 1fr auto 6.5em;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--ligne);
  }
  :global(.cdc-nom) {
    margin: 0;
    font-weight: 500;
    color: var(--anthracite);
  }
  :global(.cdc-info) {
    margin: 2px 0 0;
    font-size: 0.85rem;
    color: var(--gris);
  }
  :global(.cdc-prix) {
    margin: 0;
    text-align: right;
    font: italic 500 1.05rem/1 var(--titre);
  }
  :global(.cdc-vide) {
    color: var(--gris);
  }
  :global(.cdc-total) {
    padding: 18px 0 4px;
  }
  :global(.cdc-total p:first-child) {
    margin: 0;
    font-size: 1.1rem;
  }
  :global(.cdc-total .bouton) {
    margin-top: 16px;
    width: 100%;
    justify-content: center;
  }
  :global(.cdc-merci) {
    text-align: center;
    padding: 20px 0;
  }
  @media (max-width: 560px) {
    :global(.cdc-lignes li) {
      grid-template-columns: 1fr auto;
    }
    :global(.cdc-prix) {
      grid-column: 1 / -1;
      text-align: left;
    }
    :global(.cdc-barre) {
      gap: 12px;
      padding-left: 18px;
    }
  }
  @media (max-width: 800px) {
    .tf-grille.avec-image {
      grid-template-columns: 1fr;
    }
  }
</style>
