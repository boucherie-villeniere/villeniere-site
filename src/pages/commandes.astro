---
// Planning des commandes click & collect, réservé à la boutique.
// Une seule page : connexion (mot de passe), vue semaine + détail du jour,
// changement de statut. Les formulaires fonctionnent sans JavaScript.
import { env } from 'cloudflare:workers';
import '../styles/global.css';
import { COOKIE, DUREE_JOURS, creerJeton, jetonValide, motDePasseCorrect } from '../lib/acces';
import { ajouterJours, formaterPrix, jourDeSemaine, libelleTotal, maintenantParis, ORDRE_JOURS, prixLigne, sansEstimation } from '../lib/commande';
import SuiviArrhes from '../components/SuiviArrhes.astro';
import { getClickCollect, getTempsForts } from '../lib/data';
import { uniteAffichee } from '../lib/recap';
import { changerStatut, changerSuivi, commandesEntre, commandesSansArrhes, derniereCommande, STATUTS, totauxParFarce, totauxParPlat, totauxParSauce, trierParCreneau, type Statut } from '../lib/stockage';

export const prerender = false;

const motDePasse = env.COMMANDES_MOT_DE_PASSE;
const url = new URL(Astro.request.url);
const aujourdhui = maintenantParis().date;
const dateValide = (d: string | null) => (d && /^\d{4}-\d{2}-\d{2}$/.test(d) ? d : null);

let connecte = await jetonValide(motDePasse, Astro.cookies.get(COOKIE)?.value);
let erreur = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');
  const jour = dateValide(String(form.get('jour') ?? '')) ?? aujourdhui;

  if (action === 'connexion') {
    if (await motDePasseCorrect(motDePasse, String(form.get('mot-de-passe') ?? ''))) {
      Astro.cookies.set(COOKIE, await creerJeton(motDePasse!), {
        httpOnly: true,
        secure: url.protocol === 'https:',
        sameSite: 'lax',
        path: '/commandes',
        maxAge: DUREE_JOURS * 86_400,
      });
      return Astro.redirect(`/commandes?jour=${jour}`, 303);
    }
    // Ralentit les essais en série.
    await new Promise((r) => setTimeout(r, 1200));
    erreur = 'Mot de passe incorrect.';
  } else if (action === 'deconnexion') {
    Astro.cookies.delete(COOKIE, { path: '/commandes' });
    return Astro.redirect('/commandes', 303);
  } else if (action === 'suivi' && connecte) {
    const [champ, valeur] = String(form.get('suivi') ?? '').split(':');
    if (champ === 'arrhes' || champ === 'apitic') await changerSuivi(env.DB, String(form.get('id')), champ, valeur === '1');
    // Retour uniquement vers cette page, jamais vers une adresse fournie de l'extérieur.
    const retour = String(form.get('retour') ?? '');
    return Astro.redirect(retour.startsWith('?') ? `/commandes${retour}` : '/commandes', 303);
  } else if (action === 'statut' && connecte) {
    await changerStatut(env.DB, String(form.get('id')), String(form.get('statut')) as Statut);
    return Astro.redirect(`/commandes?jour=${jour}#${form.get('id')}`, 303);
  }
}

// État léger interrogé toutes les 20 s par la tablette : sonne à chaque nouvelle commande.
if (url.searchParams.get('etat') === '1') {
  const entetes = { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' };
  if (!connecte) return new Response('{}', { status: 401, headers: entetes });
  try {
    const d = await derniereCommande(env.DB);
    return new Response(JSON.stringify(d ? { id: d.id, nom: d.nom, date: d.date, creneau: d.creneau, evenement: d.evenement } : {}), { headers: entetes });
  } catch {
    return new Response('{}', { status: 503, headers: entetes });
  }
}

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

// Semaine (lundi → dimanche) contenant le jour choisi.
const jour = dateValide(url.searchParams.get('jour')) ?? aujourdhui;
const lundi = ajouterJours(jour, -ORDRE_JOURS.indexOf(jourDeSemaine(jour)));
const semaine = Array.from({ length: 7 }, (_, i) => ajouterJours(lundi, i));

const cc = getClickCollect();
const vueArrhes = url.searchParams.get('vue') === 'arrhes';
// Temps forts qui demandent des arrhes, retrouvés par le nom enregistré sur la commande.
const aArrhes = new Map(
  getTempsForts()
    .filter((t) => t.carte?.commande?.mentionArrhes?.trim())
    .map((t) => [t.nom, t]),
);
let aRelancer: Awaited<ReturnType<typeof commandesSansArrhes>> = [];
let commandes: Awaited<ReturnType<typeof commandesEntre>> = [];
let erreurBase = false;
let derniere = '';
if (connecte) {
  try {
    derniere = (await derniereCommande(env.DB))?.id ?? '';
    commandes = trierParCreneau(await commandesEntre(env.DB, semaine[0], semaine[6]), cc.creneaux);
    aRelancer = (await commandesSansArrhes(env.DB, aujourdhui)).filter((c) => aArrhes.has(c.evenement!));
  } catch (e) {
    console.error('[gestion] lecture impossible', e);
    erreurBase = true;
  }
}

const actives = (d: string) => commandes.filter((c) => c.date === d && c.statut !== 'annulee');
const duJour = commandes.filter((c) => c.date === jour);
const totaux = totauxParPlat(duJour);
const farces = totauxParFarce(duJour);
const sauces = totauxParSauce(duJour);
const parCreneau = new Map<string, typeof duJour>();
for (const c of duJour) parCreneau.set(c.creneau, [...(parCreneau.get(c.creneau) ?? []), c]);

const fmt = (iso: string, o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('fr-FR', { ...o, timeZone: 'UTC' }).format(new Date(`${iso}T12:00:00Z`));
const titreJour = fmt(jour, { weekday: 'long', day: 'numeric', month: 'long' });
const titreSemaine = `${fmt(semaine[0], { day: 'numeric', month: 'short' })} – ${fmt(semaine[6], { day: 'numeric', month: 'short' })}`;
const heureCommande = (iso: string) =>
  new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' }).format(new Date(iso));
const totalJour = libelleTotal(actives(jour).flatMap((c) => c.lignes));
const pluriel = (n: number, mot: string) => `${n} ${mot}${n > 1 ? 's' : ''}`;
// SMS « commande prête », préparé sur l'appareil (tant que l'envoi automatique n'est pas branché).
const smsPrete = (c: { nom: string; telephone: string; creneau: string }) =>
  `sms:${c.telephone.replace(/\s/g, '')}?&body=${encodeURIComponent(`Bonjour ${c.nom}, votre commande est prête à la boucherie Villenière (retrait ${c.creneau}). À tout de suite !`)}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    {connecte && <noscript><meta http-equiv="refresh" content="180" /></noscript>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Installable sur la tablette de la boutique (« Ajouter à l'écran d'accueil »). -->
    <link rel="manifest" href="/commandes.webmanifest" />
    <meta name="theme-color" content="#15181b" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Commandes" />
    <link rel="apple-touch-icon" href="/brand/icone-commandes-192.png" />
    <title>Commandes — Villenière</title>
  </head>
  <body>
    {
      !connecte ? (
        <main class="connexion">
          <img src="/brand/logo.svg" alt="Villenière — Boucherie" width="220" />
          <h1>Planning des commandes</h1>
          {motDePasse ? (
            <form method="post">
              <input type="hidden" name="action" value="connexion" />
              <input type="hidden" name="jour" value={jour} />
              <label for="mdp">Mot de passe</label>
              <input id="mdp" name="mot-de-passe" type="password" autocomplete="current-password" required autofocus />
              {erreur && <p class="erreur" role="alert">{erreur}</p>}
              <button class="bouton" type="submit">Entrer</button>
            </form>
          ) : (
            <p class="erreur">
              Accès non configuré : ajoutez le secret <code>COMMANDES_MOT_DE_PASSE</code> dans Cloudflare (Settings → Runtime variables and secrets).
            </p>
          )}
        </main>
      ) : (
        <div class="gestion" data-derniere={derniere}>
          <header class="barre">
            <a href="/commandes" class="marque">
              <img src="/brand/logo.svg" alt="Villenière" width="130" />
              <span>Commandes</span>
            </a>
            <div class="barre-droite">
              <button type="button" id="alertes" class="alertes" hidden>Activer les alertes sonores</button>
              {aArrhes.size > 0 && (
                <a href={vueArrhes ? '?' : '?vue=arrhes'} class:list={['lien-arrhes', { actif: vueArrhes }]}>
                  Arrhes à recevoir <span class="lien-arrhes-n">{aRelancer.length}</span>
                </a>
              )}
              <form method="post">
                <input type="hidden" name="action" value="deconnexion" />
                <button type="submit" class="lien-discret">Se déconnecter</button>
              </form>
            </div>
          </header>
          <button type="button" id="alerte" class="alerte" hidden></button>

          <div id="zone">
          {vueArrhes ? (
            <main class="detail">
              <div class="detail-tete">
                <h1>Arrhes à recevoir</h1>
                <p>{pluriel(aRelancer.length, 'commande')}, de la plus proche à la plus lointaine</p>
              </div>
              {aRelancer.length === 0 && <p class="tout-pret">Toutes les arrhes sont reçues.</p>}
              <ul class="cartes">
                {aRelancer.map((c) => (
                  <li class="carte">
                    <span class="evenement">{c.evenement}</span>
                    <h3>{c.nom}</h3>
                    <a class="tel" href={`tel:${c.telephone.replace(/\s/g, '')}`}>{c.telephone}</a>
                    <p class="retrait">Retrait : <a href={`?jour=${c.date}#${c.id}`}>{fmt(c.date, { weekday: 'long', day: 'numeric', month: 'long' })}, {c.creneau}</a></p>
                    <p class="total">
                      <span>Total estimé</span> <strong>{libelleTotal(c.lignes)}</strong>
                    </p>
                    <SuiviArrhes commande={c} temps={aArrhes.get(c.evenement!)!} retour="?vue=arrhes" />
                  </li>
                ))}
              </ul>
            </main>
          ) : (
          <>
          <nav class="semaine" aria-label="Choisir un jour">
            <div class="semaine-tete">
              <a class="nav" href={`?jour=${ajouterJours(lundi, -7)}`} aria-label="Semaine précédente">←</a>
              <span class="semaine-titre">{titreSemaine}</span>
              <a class="nav" href={`?jour=${ajouterJours(lundi, 7)}`} aria-label="Semaine suivante">→</a>
              {!semaine.includes(aujourdhui) && <a class="nav nav-auj" href="?">Aujourd’hui</a>}
            </div>
            <ol class="jours">
              {semaine.map((d) => {
                const n = actives(d).length;
                const ferme = !cc.joursRetrait.includes(jourDeSemaine(d)) || cc.fermetures.includes(d);
                return (
                  <li>
                    <a
                      href={`?jour=${d}`}
                      class:list={['jour', { actif: d === jour, auj: d === aujourdhui, ferme, plein: n > 0 }]}
                      aria-current={d === jour ? 'date' : undefined}
                    >
                      <span class="jour-nom">{fmt(d, { weekday: 'short' }).replace('.', '')}</span>
                      <span class="jour-num">{fmt(d, { day: 'numeric' })}</span>
                      <span class="jour-n">{n > 0 ? n : ferme ? '—' : '0'}</span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </nav>

          <main class="detail">
            <div class="detail-tete">
              <h1>
                {titreJour}
                {jour === aujourdhui && <span class="pastille">Aujourd’hui</span>}
              </h1>
              <p>
                {pluriel(actives(jour).length, 'commande')}
                {actives(jour).length > 0 && <> · {totalJour}, estimé</>}
              </p>
            </div>

            {erreurBase && <p class="erreur">Les commandes n’ont pas pu être chargées. Rechargez la page dans un instant.</p>}

            {totaux.length > 0 && (
              <section class="a-preparer" aria-labelledby="ap">
                <h2 id="ap">À préparer</h2>
                <ul>
                  {totaux.map((t) => (
                    <li>
                      <strong>{t.quantite}</strong> <span class="unite">{uniteAffichee(t.unite, t.quantite)}</span> {t.nom}
                    </li>
                  ))}
                </ul>
                {farces.length > 0 && (
                  <p class="a-farcir">
                    <strong>Farces :</strong> {farces.map((f) => `${f.quantite} × ${f.nom}`).join(', ')}
                  </p>
                )}
                {sauces.map((f) => (
                  <p class="a-farcir">
                    <strong>{f.nom} :</strong> {f.quantite} plat{f.quantite > 1 ? 's' : ''}
                  </p>
                ))}
              </section>
            )}

            {totaux.length === 0 && actives(jour).length > 0 && <p class="tout-pret">Tout est prêt pour ce jour.</p>}

            {duJour.length === 0 && !erreurBase && <p class="vide">Aucune commande pour ce jour.</p>}

            {[...parCreneau].map(([creneau, liste]) => (
              <section class="creneau">
                <h2>{creneau}</h2>
                <ul class="cartes">
                  {liste.map((c) => (
                    <li id={c.id} class:list={['carte', `carte--${c.statut}`]}>
                      <div class="carte-tete">
                        <div>
                          {c.evenement && <span class="evenement">{c.evenement}</span>}
                          <h3>{c.nom}</h3>
                          <a class="tel" href={`tel:${c.telephone.replace(/\s/g, '')}`}>{c.telephone}</a>
                          {c.email && <a class="mail" href={`mailto:${c.email}`}>{c.email}</a>}
                          {c.sms && c.statut !== 'annulee' && (
                            <a class="sms" href={smsPrete(c)}>
                              Souhaite un SMS · <span>préparer « commande prête »</span>
                            </a>
                          )}
                        </div>
                        <span class:list={['statut', `statut--${c.statut}`]}>{STATUTS[c.statut]}</span>
                      </div>
                      <ul class="lignes">
                        {c.lignes.map((l) => (
                          <li>
                            <span>
                              <strong>{l.quantite} ×</strong> {l.nom}
                            </span>
                            <span>{sansEstimation(l) ? prixLigne(l) : `${formaterPrix(l.total)}${l.aLaPesee ? '*' : ''}`}</span>
                          </li>
                        ))}
                      </ul>
                      <p class="total">
                        <span>Total estimé</span> <strong>{libelleTotal(c.lignes)}</strong>
                      </p>
                      {c.lignes.some((l) => l.aLaPesee) && <p class="pesee">* au poids : montant estimé, à ajuster à la pesée</p>}
                      {c.remarque && <p class="remarque">« {c.remarque} »</p>}
                      {c.evenement && aArrhes.has(c.evenement) && c.statut !== 'annulee' && (
                        <SuiviArrhes commande={c} temps={aArrhes.get(c.evenement)!} retour={`?jour=${jour}#${c.id}`} />
                      )}
                      <form method="post" class="actions">
                        <input type="hidden" name="action" value="statut" />
                        <input type="hidden" name="id" value={c.id} />
                        <input type="hidden" name="jour" value={jour} />
                        {(Object.keys(STATUTS) as Statut[])
                          .filter((s) => s !== c.statut)
                          .map((s) => (
                            <button
                              type="submit"
                              name="statut"
                              value={s}
                              class:list={['action', `action--${s}`]}
                              onclick={s === 'annulee' ? "return confirm('Annuler cette commande ?')" : undefined}
                            >
                              {s === 'a-preparer' ? 'Remettre à préparer' : s === 'prete' ? 'Prête' : s === 'retiree' ? 'Retirée' : 'Annuler'}
                            </button>
                          ))}
                      </form>
                      <p class="recue">Reçue le {heureCommande(c.creeLe)}</p>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </main>
          </>
          )}
          </div>
        </div>
      )
    }
  </body>
</html>

<script>
  // Tablette de la boutique : toutes les 20 s, on regarde s'il y a une nouvelle
  // commande. Si oui : son, bandeau, et le planning se met à jour sans recharger
  // la page (le son reste activé). L'écran reste allumé tant que les alertes sont actives.
  const gestion = document.querySelector<HTMLElement>('.gestion');
  const bouton = document.getElementById('alertes') as HTMLButtonElement | null;
  const alerte = document.getElementById('alerte') as HTMLButtonElement | null;
  if (gestion && bouton && alerte) {
    let derniere = gestion.dataset.derniere ?? '';
    let audio: AudioContext | null = null;
    bouton.hidden = false;
    try {
      if (localStorage.getItem('alertes') === '1') {
        bouton.textContent = 'Touchez pour réactiver les alertes';
        bouton.classList.add('a-reactiver');
      }
    } catch {
      /* stockage indisponible */
    }

    const sonner = () => {
      if (!audio) return;
      const t0 = audio.currentTime;
      [0, 0.18, 0.36, 1, 1.18, 1.36].forEach((d, i) => {
        const o = audio!.createOscillator();
        const g = audio!.createGain();
        o.frequency.value = [880, 1108, 1318][i % 3];
        g.gain.setValueAtTime(0.0001, t0 + d);
        g.gain.exponentialRampToValueAtTime(0.6, t0 + d + 0.02);
        g.gain.exponentialRampToValueAtTime(0.0001, t0 + d + 0.3);
        o.connect(g).connect(audio!.destination);
        o.start(t0 + d);
        o.stop(t0 + d + 0.32);
      });
    };
    const garderEcranAllume = async () => {
      try {
        await (navigator as Navigator & { wakeLock?: { request(t: 'screen'): Promise<unknown> } }).wakeLock?.request('screen');
      } catch {
        /* non pris en charge : sans gravité */
      }
    };
    bouton.addEventListener('click', async () => {
      audio ??= new AudioContext();
      await audio.resume();
      sonner();
      garderEcranAllume();
      bouton.textContent = 'Alertes sonores activées';
      bouton.classList.remove('a-reactiver');
      bouton.classList.add('actif');
      try {
        localStorage.setItem('alertes', '1');
      } catch {
        /* idem */
      }
    });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && audio) garderEcranAllume();
    });
    alerte.addEventListener('click', () => {
      alerte.hidden = true;
      const cible = alerte.dataset.lien;
      if (cible) location.href = cible;
    });

    const rafraichir = async () => {
      try {
        const r = await fetch(location.href, { cache: 'no-store' });
        if (!r.ok) return;
        const nouvelle = new DOMParser().parseFromString(await r.text(), 'text/html').getElementById('zone');
        if (nouvelle) document.getElementById('zone')?.replaceWith(nouvelle);
      } catch {
        /* hors ligne : on réessaiera */
      }
    };
    const jourLong = (iso: string) =>
      new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' }).format(new Date(`${iso}T12:00:00Z`));
    const verifier = async () => {
      try {
        const r = await fetch('/commandes?etat=1', { cache: 'no-store' });
        if (r.status === 401) return location.reload();
        if (!r.ok) return;
        const e = (await r.json()) as { id?: string; nom?: string; date?: string; creneau?: string; evenement?: string | null };
        if (!e.id || e.id === derniere) return;
        derniere = e.id;
        alerte.innerHTML = '';
        const titre = document.createElement('strong');
        titre.textContent = 'Nouvelle commande';
        const detail = document.createElement('span');
        detail.textContent = `${e.evenement ? `${e.evenement} · ` : ''}${e.nom} · retrait ${jourLong(e.date!)}, ${e.creneau}`;
        const voir = document.createElement('span');
        voir.className = 'alerte-voir';
        voir.textContent = 'Voir →';
        alerte.append(titre, detail, voir);
        alerte.dataset.lien = `/commandes?jour=${e.date}#${e.id}`;
        alerte.hidden = false;
        sonner();
        await rafraichir();
      } catch {
        /* réseau coupé : prochain essai dans 20 s */
      }
    };
    setInterval(verifier, 20_000);
    setInterval(rafraichir, 120_000);
  }
</script>

<style>
  body {
    min-height: 100vh;
  }
  /* Tablette tactile : tout un cran plus grand, lisible à bout de bras. */
  @media (pointer: coarse) and (min-width: 700px) {
    :global(html) {
      font-size: 112.5%;
    }
  }
  .alertes {
    min-height: 40px;
    padding: 6px 14px;
    border: 1px solid var(--anthracite);
    border-radius: 999px;
    background: var(--blanc);
    font: 500 0.88rem/1.2 var(--corps);
    cursor: pointer;
  }
  .alertes.actif {
    border-color: #2f6b34;
    color: #2f6b34;
  }
  .alertes.a-reactiver {
    background: var(--or);
    border-color: var(--or);
    animation: clignoter 1.6s ease-in-out infinite;
  }
  @keyframes clignoter {
    50% {
      opacity: 0.55;
    }
  }
  .alerte {
    position: sticky;
    top: 8px;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    width: 100%;
    margin: 14px 0 0;
    padding: 16px 20px;
    border: 0;
    border-radius: 8px;
    background: var(--or);
    color: var(--anthracite);
    font: 400 1.05rem/1.35 var(--corps);
    text-align: left;
    box-shadow: 0 12px 30px -12px rgb(21 24 27 / 0.6);
    cursor: pointer;
  }
  .alerte strong {
    font: italic 700 1.4rem/1 var(--titre);
  }
  .alerte-voir {
    margin-left: auto;
    font-weight: 500;
  }
  .sms {
    display: inline-block;
    margin-top: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--or-clair);
    color: var(--anthracite);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
  }
  .sms span {
    text-decoration: underline;
  }

  /* Connexion */
  .connexion {
    max-width: 360px;
    margin: 0 auto;
    padding: 12vh 16px 40px;
    text-align: center;
  }
  .connexion img {
    margin: 0 auto 28px;
  }
  .connexion h1 {
    font-size: 1.8rem;
    margin-bottom: 28px;
  }
  .connexion form {
    display: grid;
    gap: 10px;
    text-align: left;
  }
